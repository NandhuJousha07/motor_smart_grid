# Motor Smart GRID – Apache settings (ignored on Nginx/IIS; see DEPLOYMENT_GUIDE.md section 6)

Options -Indexes
DirectoryIndex motor-smart-grid.html index.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/json .json
  AddCharset utf-8 .json .css .js .html
</IfModule>

<IfModule mod_headers.c>
  # Keep search engines out of the GRID
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
  # Always check for new GRID data / page changes (a new version must show the same day)
  <FilesMatch "\.(json|html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Never serve these
<FilesMatch "(\.md|\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
